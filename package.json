{
  "name": "lapis",
  "version": "0.2.0",
  "private": true,
  "description": "Lapis is a local-first AI writing studio for stories, from short fiction to novels.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false && npm run bundle -w @lapis/web",
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev -w @lapis/server\" \"npm run dev -w @lapis/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:build": "node scripts/build-release.mjs",
    "lint": "eslint . --max-warnings=0",
    "licenses:check": "node scripts/check-licenses.mjs --check",
    "licenses:update": "node scripts/check-licenses.mjs --write",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:golden": "vitest run packages/persistence/test/long-novel-golden.test.ts",
    "test:evidence": "tsx scripts/evidence-protocol-eval.ts",
    "test:retrieval": "tsx scripts/retrieval-eval.ts --check",
    "eval:retrieval:real": "tsx scripts/retrieval-eval.ts --embedder=openai",
    "test:coverage": "vitest run --coverage",
    "test:real": "tsx scripts/llm-real-smoke.ts",
    "test:real:capabilities": "tsx scripts/llm-real-smoke.ts",
    "test:real:chapter": "tsx scripts/chapter-real-smoke.ts",
    "test:real:autopilot": "tsx scripts/autopilot-real-smoke.ts",
    "test:real:studio": "tsx scripts/studio-real-smoke.ts",
    "test:real:delivery": "tsx scripts/delivery-real-smoke.ts",
    "test:real:matrix": "npm run test:real:capabilities && npm run test:real:chapter && npm run test:real:autopilot && npm run test:real:studio && npm run test:real:delivery",
    "test:release:recovery": "vitest run apps/server/test/lifecycle-api.test.ts apps/server/test/backup-restore-r8.test.ts apps/server/test/run-partial-recovery.test.ts packages/persistence/test/orphan-interruption.test.ts",
    "seed:example": "tsx scripts/seed-example.ts",
    "docs:screenshots": "tsx scripts/docs-screenshots.ts",
    "typecheck": "tsc -b --pretty false && tsc -p scripts/tsconfig.json --noEmit --pretty false",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:evidence && npm run test:retrieval && npm run licenses:check && npm run build",
    "verify:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:evidence && npm run test:retrieval && npm run licenses:check",
    "verify:release": "npm run verify:ci && npm run test:e2e && npm run test:release:recovery && npm run test:real:matrix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
